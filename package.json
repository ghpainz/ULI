{
  "name": "uli",
  "productName": "ULI",
  "version": "0.5.0",
  "description": "ULI — Premiere Pro sadeliğinde, CapCut zenginliğinde video kurgu uygulaması",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "predist": "node tools/fetch-whisper.js && node tools/fetch-mediapipe-models.js && node tools/fetch-rnnoise.js",
    "dist": "electron-builder --win nsis --x64",
    "fetch-whisper": "node tools/fetch-whisper.js",
    "test": "node tests/run.js"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "author": "ghpainz",
  "build": {
    "appId": "com.ghpainz.uli",
    "productName": "ULI",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "src/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**",
      "!node_modules/@mediapipe/tasks-vision/wasm/vision_wasm_module_internal.*",
      "!node_modules/@mediapipe/tasks-vision/wasm/vision_wasm_nosimd_internal.*",
      "!node_modules/@mediapipe/tasks-vision/*.map"
    ],
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE",
        "to": "licenses/FFmpeg-GPL-3.0.txt"
      }
    ],
    "extraResources": [
      {
        "from": "vendor/whisper",
        "to": "whisper"
      },
      {
        "from": "vendor/mediapipe-models",
        "to": "mediapipe-models"
      },
      {
        "from": "vendor/rnnoise",
        "to": "rnnoise"
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/bin/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "guid": "7b5e5154-359f-572c-b486-92908d8a0753",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ULI"
    },
    "fileAssociations": [
      {
        "ext": "ulip",
        "name": "ULI Project",
        "description": "ULI Projesi",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ]
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "^26.18.0"
  }
}
